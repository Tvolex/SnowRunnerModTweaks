{
  "title": "SnowRunner truck frame-flex comparison",
  "scope": "Truck XML files under [media]/**/classes/trucks; accessory tuning XML excluded.",
  "method": {
    "comparison": "Current FrameFlex motor values were blended toward the corresponding FrameFlexOldMod values. No wheelbase multiplier or prior coefficient formula was used.",
    "limits": "MinLimit and MaxLimit are copied exactly from the matched FrameFlexOldMod cabin/twist hinge.",
    "damping": "Geometric interpolation 50% toward the old-mod value: new = current^0.50 * old^0.50. This intermediate damping is intended to reduce loaded-cargo motion without restoring the full old stiffness.",
    "spring": "Geometric interpolation 65% toward the old-mod value: new = current^0.35 * old^0.65. The greater move toward old spring is intended to resist quick flex on unloaded bumps.",
    "rounding": "Damping and Spring rounded to nearest integer. Limit attributes retain the exact old-mod values.",
    "scope_note": "Only Damping and Spring on matched frame motors and MinLimit/MaxLimit on their hinge constraints were changed in FrameFlex. FrameFlexOldMod was read-only."
  },
